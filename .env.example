GOOGLE_CLIENT_ID=582957492765-p79opkim5qimgf91tmiubdkptfdjp08h.apps.googleusercontent.com.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# The full URL of your callback route (must match what you set in Google Console)
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ── Session ───────────────────────────────────────────────────────────────────
