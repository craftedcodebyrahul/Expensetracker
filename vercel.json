{
  "version": 2,
  "buildCommand": "npx prisma generate && node node_modules/@angular/cli/bin/ng.js build",
  "installCommand": "npm install",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "node_modules/@prisma/client/**,node_modules/.prisma/**,node_modules/@prisma/adapter-libsql/**,node_modules/@libsql/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}

